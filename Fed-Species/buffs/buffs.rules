XSShieldcoreDebuff
{
	CombineMode = Add
	//Exponent = 1//an exponent, e.g. 2^10 where 2 is the # of parts and 10 is the exponent // 2 gives 2>5>10>17>26>37>50  
	//						+1>+3>+5>+7>+9>+11>+13
	//				 10 gives 2 > 1,025 > 59,050 > 1,048,577
	//						 +1 > +1,023 > +58,025 > +989,527
	Exponent = 2.02
	Multiplier = 8%//Caps out @12
	BaseValue = 100%
	RectBorderColor = [11, 195, 212, 3]
	RectFillColor = [11, 195, 212, 2]
	Icon
	{
		Texture
		{
			File = "debuff_phaser.png"
			MipLevels = 2
			SampleMode = Linear
		}
		Size = [1, 1]
	}
		IconPriority = 1 
}
