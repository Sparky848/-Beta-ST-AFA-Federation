
Components
{
	LeftModeIsBurstBuffProvider
	{
		Type = AreaBuffProvider
		BuffType = ModeIsBurst
		BuffArea = [-1, 1, 1, 7]
		Criterias
		[
			{
				IDs = [stafa.fed_vengeance_capacitor, stafa.fed_vengeance_capacitor_walkable]
			}
		]
	}
	RightModeIsBurstBuffProvider
	{
		Type = AreaBuffProvider
		BuffType = ModeIsBurst
		BuffArea = [3, 1, 1, 7]
		Criterias
		[
			{
				IDs = [stafa.fed_vengeance_capacitor, stafa.fed_vengeance_capacitor_walkable]
			}
