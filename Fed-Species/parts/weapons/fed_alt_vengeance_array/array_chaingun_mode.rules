	Turret
	{
		Type = TurretWeapon
		Location = [1.5, 1.640625]
		Rotation = -90d// Relative to unrotated part.
		OperationalToggle = IsOperational
		AutoFireToggle = AutoFireToggle
		FireInterval = { BaseValue=4; BuffType=RateOfFire; BuffMode=Divide; }
		FiringArc = 80d
		RotateSpeed = 22.5d
		FireThresholdAngle = 1d
		AIFirepowerRating = 2500
		FirePermissionToggle = FireModeToggle
		IgnoreSourceShipLowLOSChecks = true
		IgnoreSourceShipHighLOSChecks = true
		IgnoreJunkLOSChecks = true
		Emitter = BulletEmitter
			AutoTargets
		[
			{
				TargetType = ShipParts
				Toggle = AutoTargetToggle
			}
		]
			BlueprintArcSprite
		{
			Texture = &/INDICATORS/WeaponArc
			Size = [0, 1.5]
			Color = [255, 0, 0, 63]
		}
		BlueprintArcRadius = 10
		BlueprintArcSpriteSegments = 64
			CoverageSectorArc
		{
			Texture = &/INDICATORS/VerticalGradient
			VertexColor = [255, 255, 255, 51]
			QuadCount = 64
		}
	}
	RateOfFireRampUpBuff
	{
		Type = SelfBuffProvider
		BuffType = RateOfFire  //used as divide by the fixed weapon fire rate
		BuffAmount = 1
		BuffMultiplier = RampUpAccumulator
	}
	RampUpAccumulator
	{
		Type = ValueAccumulator
		AccumulatingToggle = GunIsFiring
		BASE_MAX_VALUE = 24 // 1 / (3/12) = 4 shots/sec where 3 is fire interval
		BASE_RAMP_UP_TIME = 20//15
		BASE_RAMP_DOWN_TIME = 5
		BASE_RAMP_PER_SEC = ((&BASE_MAX_VALUE) - (&MinValue)) / (&BASE_RAMP_UP_TIME)
		AccumulationRate = &BASE_RAMP_PER_SEC
		DissipationRate = (&BASE_RAMP_PER_SEC) * 8 //cooldown is half the ramp up
		BaseValue = &MinValue
		MinValue = 1
		MaxValue = (&BASE_MAX_VALUE)
	}
	IsOperationalToggleTrigger
	{
		Type = ToggleTrigger
		Toggle = IsOperational
		TriggerWhenOff = true
		TriggerWhenOn = false
	}
	BulletEmitterOrIsOperationalToggleTrigger
	{
		Type = MultiTrigger
		Triggers = [BulletEmitter, IsOperationalToggleTrigger]
	}
	GunIsFiringTimer //Is on if we have fired a shot
	{
		Type = Timer
		// Only count down while not reloading, unless the shell isn't fully open
		//OperationalToggle = IsOperational
		Duration = 4
		StartTrigger = BulletEmitter
		StopTrigger = IsOperationalToggleTrigger
		ResetTrigger = BulletEmitterOrIsOperationalToggleTrigger
		StartExpired = true
		InvertToggle = true
	}
	GunIsFiring
	{
		Type = MultiToggle
		Toggles = [GunIsFiringTimer, VengeanceBatteryStorage]
		Mode = All
	}
	
	BulletEmitterProxy
	{
		Type = BeamEmitterProxy
		Location = &../BulletEmitter/Location
		ChainedTo = &../BulletEmitter/ChainedTo
		ComponentID = BulletEmitter
	}
	ReloadProgressBar
	{
		Type = ProgressBar
		OperationalToggle = IsOperational
		ShowProgressFor = Turret
		Invert = false
	}
	BulletEmitter
	{
		Type = BulletEmitter
		ChainedTo = Turret
		FireTrigger = Turret
		GetTargetFrom = Turret
		Location = [1.5, -0.15]//[1.5, 0]
		OperationalToggle = IsOperational
		Burst = 1
		Bullet = &<../../../shots/vengeance_bolt/vengeance_bolt.rules>
		ResourceStorage = VengeanceBatteryStorage
		ResourcesUsed = 3000//{ BaseValue = 1500; BuffType=RateOfFire; BuffMode=Multiply; }
		Spread = [-2d, 2d]
		MinResourcesUsed = 1
	}
	FireEffect
	{
		Type = TriggeredEffects
		ChainedTo = BulletEmitter
		Trigger = BulletEmitter
		Location = [0.5, 0]
		AnchorMediaEffects = true
			MediaEffects
		[
			//&<particles/dual_phaser_cannon_shoot.rules>
			//&<particles/dual_phaser_cannon_shoot_flash.rules>
				: /BASE_SOUNDS/AudioExterior
			{
				Sound = "shoot2.wav"
				Volume = 10
				SpeedVariation = .25
			}
		]
	}

	WeaponIsTargeting
	{
		Type = MultiToggle
		Toggles = [Turret]
		Mode = Any
	}
	CrewLocation1
	{
		Type = CrewLocation
		Location = [-0.32, 0]
		ChainedTo = Turret
		Rotation = 90d
	}
	PartCrew
	{
		Type = PartCrew
		Crew = 1
		DefaultPriority = &/PRIORITIES/Weapon_Crew
		PrerequisitesBeforeCrewing = [PowerToggle]
		HighPriorityPrerequisites = [BatteryStorage]
		CrewDestinations
		[
			[1.5, 3.3125]//[1.484375, 1.96875]
		]
		CrewLocations
		[
			CrewLocation1
		]
	}
