		{
			Type = MultiToggle
			Toggles = [FireModeBurstToggle, OutOfVengeancePower]
			Mode = Any
		}
		NotOutOfVengeancePower
		{
			Type = MultiToggle
			Toggles = [{Toggle = OutOfVengeancePower; Invert = true}]
			Mode = Any
		}
		FireModeChaingunToggleAndNotOutOfVengeancePower
		{
			Type = MultiToggle
			Toggles = [FireModeChaingunToggle, NotOutOfVengeancePower]
			Mode = All
		}
		
