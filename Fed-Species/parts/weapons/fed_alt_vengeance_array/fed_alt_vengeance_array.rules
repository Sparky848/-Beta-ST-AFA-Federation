		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 4]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 4]
			Layer = "indicators"
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [.5, .5]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					Delay = (&~/Part/Components/FireModeBurstComponents/Components/Turret/FireInterval) * 5
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [.5, .5]
					}
				}

				//No Dual Ops Room
				{
					Toggle = VengeanceArrayOperationBuffToggle
					ShowInBuildMode = true
					AtlasSprite
					{
						File = &/INDICATORS/MissingComponent
						Size = [.5, .5]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 8]
		}
	}

	Stats
	{
		CrewRequired = 1
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 200

		RecPower = &../StatsByCategory/0/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 4
	}


	StatsByCategory
	[
		{
			NameKey = "StatCategories/PhaserBolt"
			Stats
			{
				DamagePerShot = (&~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Bullet/Components/Hit/HitOperational/HitEffects/0/TotalDamage/BaseValue)
				DamagePerSecond = (((&DamagePerShot) * 2) * (&~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Burst)) * 3 * (&ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				ROF = 1 / (&~/Part/Components/FireModeBurstComponents/Components/Turret/FireInterval)
				RangeLimited = [&~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Bullet/Range/BaseValue, &~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Bullet/Range/MaxValue]
				Arc = deg(&~/Part/Components/FireModeBurstComponents/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/FireModeBurstComponents/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Bullet/Speed/BaseValue
				ShotHP = &~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Bullet/Components/Targetable/Health
				PowerPerShot = (&~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/ResourcesUsed/BaseValue) / 1000
				PowerPerSecond = (&PowerPerShot) * (&~/Part/Components/FireModeBurstComponents/Components/BulletEmitter/Burst) * (&ROF)
				ShotPowerUsage = [(&../PowerPerShot) , &../PowerPerSecond]
			}
		}
	]
}