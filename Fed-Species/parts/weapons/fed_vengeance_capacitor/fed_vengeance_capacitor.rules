		VengeanceCapacitorCounterBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = VengeanceCapacitorCounter
			BuffAmount = { BaseValue=1; BuffType=VengeanceCapacitorCounter; BuffMode=Add; }
			BuffArea = [1, 0, 1, 2]
			OperationalToggle = IsOperational	
			ChainsFromBuffType = VengeanceCapacitorCounter
			Criterias
			[
				{
					IDs = [stafa.fed_vengeance_capacitor]
					Rot = 0
					Top = 0
					Bottom = 2
					FlipX = false
				}
				{
					IDs = [stafa.fed_vengeance_capacitor]
					Rot = 0
					Top = 0
					Bottom = 2
					FlipX = true
				}
			]
			ShowBuffRange = true
		}
		VengeanceCapacitorCounterWeaponConnectorBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = VengeanceCapacitorCounter
			BuffAmount = { BaseValue=1; BuffType=VengeanceCapacitorCounter; BuffMode=Add; }
			BuffArea = [1, 0, 1, 2]
			OperationalToggle = IsOperational	
			ChainsFromBuffType = VengeanceCapacitorCounter
			Criterias
			[
				{
					IDs = [stafa.fed_alt_vengeance_array]
					FlipX = false
				}
				{
					IDs = [stafa.fed_alt_vengeance_array]
					FlipX = true
				}
			]
			ShowBuffRange = true
		}

		VengeanceArrayCounter
		{
			Type = SelfBuffProvider
			BuffType = VengeanceArrayCounter
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 6000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		PowerDrain
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			FromStorage = BatteryStorage
			FromQuantity = 250
			MinFromQuantityForConversion = 1
			Interval = 1
		}
		InternalCapacity
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = BatteryStorage
			Invert = false
			LowColor = [170, 183, 0]
			HighColor = [238, 255, 0]
			FullColor = [238, 255, 0]
			Height = 7
		}
		
		Graphics
		{
			Type = Graphics
			Location = [0.5, 1]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [1, 2]
					}
					{
						File = "floor_33.png"
						Size = [1, 2]
