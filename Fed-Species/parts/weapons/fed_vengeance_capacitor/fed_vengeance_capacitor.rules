Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/Vengeance_Capacitor"
	IconNameKey = "Parts/Vengeance_CapacitorIcon"
	ID = "stafa.fed_vengeance_capacitor"
	OtherIDs = [fed_vengeance_capacitor_L, fed_vengeance_capacitor_R, stafa.fed_vengeance_capacitor_L, stafa.fed_vengeance_capacitor_R]
	FlipWhenLoadingIDs = [fed_vengeance_capacitor_R, stafa.fed_vengeance_capacitor_R]
	//EditorGroup = "StarfleetWeapons"
	EditorParentParts = ["stafa.fed_alt_vengeance_array"]
	DescriptionKey = "Parts/Vengeance_CapacitorDesc"
	Resources
	[
		[duranium_alloy, 10]
		[steel, 8]
		[coil2, 4]
	]
	Size = [1, 2]
	SelectionTypeByRotation = true
	MaxHealth = 6000
	IsFlippable = true
	TypeCategories = [vengeance_capacitor, vengeance_battery_requester, vengeance_battery_supplier]
	ReceivableBuffs : ^/0/ReceivableBuffs [AntimatterPower, VengeanceCapacitor, VengeanceCapacitorCounter, VengeanceArrayCounter, ModeIsBurst, ModeIsChaingun, VengeanceCapacitorConnection, GunIsFiringBuff, VengeanceCapacitorVisual, VisualVengeanceCapacitorCounter, VisualVengeanceCapacitor]
	AllowedDoorLocations
	[
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorageProxyOrVengeanceBatteryStorageProxy]
			Mode = All
		}
		VengeanceBatteryStorageProxy
		{
			Type = ToggleProxy
			ComponentID = VengeanceBatteryStorage
		}
		BatteryStorageProxy
		{
			Type = ToggleProxy
			ComponentID = BatteryStorage
		}
		BatteryStorageProxyOrVengeanceBatteryStorageProxy
		{
			Type = MultiToggle
			Toggles = [BatteryStorageProxy, VengeanceBatteryStorageProxy]
			Mode = Any
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 4
		}

		RoofVisibilityToggle
		{
			Type = UIToggle
			ToggleID = "roof_type_toggle_stafa"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		RoofVisibleMode
		{
			Type = ModeToggle
			Mode = RoofVisibilityToggle
			OnMode = 0
		}

		RoofHiddenMode
		{
			Type = ModeToggle
			Mode = RoofVisibilityToggle
			OnMode = 1
		}
