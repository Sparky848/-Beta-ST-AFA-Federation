Part : <base_part.rules>/Part
{
	SalvageProgressMediaEffectsTimeout = 1
	SalvageProgressMediaEffects
	[
		&<./Data/ships/common/particles/salvage_progress_sparks.rules>
		&<./Data/ships/common/particles/salvage_progress_ship_smoke.rules>
		&<./Data/ships/common/particles/salvage_progress_ship_quad.rules>
		: /BASE_SOUNDS/AudioExterior
		{
			Sound = "./Data/ships/common/sounds/metal_deconstruct_loop.wav"
			Volume = 1
			SpeedOverIntensity = [1.5, 2.5] // Intensity over progress
			VolumeOverIntensity = 1
			RampUpTime = .1
			RampDownTime = .45
			MaxConcurrent = 0
		}
	]

	ConstructionProgressMediaEffects
	[
		&<./Data/ships/common/particles/construction_scaffolding_progress_quad.rules>
	]
	ConstructionProgressMediaEffectsTimeout = 1

	ConstructionSwapDelay = 0.2
	ConstructionFinishedMediaEffects
	[
		&<construction/particles/scaffolding_poof_wisps.rules>
		&<construction/particles/scaffolding_poof_energy.rules>
		&<construction/particles/scaffolding_poof_energy_simple.rules>
		&<construction/particles/scaffolding_poof_shadow_quad.rules>
		&<construction/particles/scaffolding_poof_flash.rules>

		: /BASE_SOUNDS/AudioExterior
		{
			Sound = "./Data/ships/common/sounds/small_construct.wav"
			Speed = 1
			SpeedVariation = 0.1
		}
	]

	Components : ^/0/Components
	{
		SalvagedEffects
		{
			Type = DeathEffects
			//Location = [0.5, 0.5]
			WhenSalvaged = true

			MediaEffects
			[
				&<./Data/ships/common/particles/salvage_complete_ship_shrapnel.rules>
				&<./Data/ships/common/particles/salvage_complete_ship_flash.rules>
				&<./Data/ships/common/particles/salvage_complete_ship_smoke.rules>


				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/ships/common/sounds/metal_deconstruct_small_01.wav",
									"./Data/ships/common/sounds/metal_deconstruct_small_02.wav",
									"./Data/ships/common/sounds/metal_deconstruct_small_03.wav"]
					Volume = 1.3
					SpeedVariation = .15
				}
				
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./Data/ships/common/sounds/small_deconstruct.wav"
					Speed = 1
					SpeedVariation = 0.1
				}
			]
		}

		ConstructionStructureSprites
		{
			Type = SpriteGrid
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			Layer = "structure"
			RectType = Physical
			RandomUVRotation = true
			AtlasSprite = &<./Data/ships/terran/structure/structure.rules>/Part/Components/Graphics/Floor/DamageLevels/0
		}

		ConstructionProgressSprites
		{
			Type = BlendSpriteGrid
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			Layer = "construction"
			AmbiguousSprites = &<./Data/ships/terran/construction/scaffolding.rules>/AmbiguousSprites
			AllowUndefinedBlendSprites = true
			BlendsWithCategories = []
			AlwaysBlendWithSelf = true
			UseConstructionProgressAsDamage = true
		}

		ConstructionProgressAnimationSprites
		{
			Type = BlendSpriteGrid
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			GetColorFrom = ConstructionTracker
			Layer = "construction_delta"
			AmbiguousSprites = &<./Data/ships/terran/construction/scaffolding_delta/scaffolding_delta.rules>/AmbiguousSprites
			AllowUndefinedBlendSprites = true
			BlendsWithCategories = []
			AlwaysBlendWithSelf = true
			UseConstructionProgressAsDamage = true
		}
	}
}