		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [3, 3]
		}
		MainShieldStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = MainShieldStorage
			ResourceType = battery
			IsDrainable = false
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [3, 3]
			Layer = "indicators"
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1.5, 1.5]
					}
				}

				// Out of power.
				{
					Toggle = MainShieldStorageProxy
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1.5, 1.5]
					}
				}
				// No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1.5, 1.5]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [6, 6]
		}
	}

	Stats
	{
		//ShieldHP = (&~/Part/Components/MainShieldBatteryStorage/MaxResources) / (&<BaseShield.rules>/Part/Components/BaseArcShield/ResourceDrainPerDamage)
		ShieldPenResist = &~/Part/Components/BaseArcShield/PenetrationResistance/0
		ShieldArc = deg(&<BaseShield.rules>/Part/Components/BaseArcShield/Arc)
		ShieldDist = (&<BaseShield.rules>/Part/Components/BaseArcShield/Radius) - (&<BaseShield.rules>/Part/Components/BaseArcShield/Location/1)
		PowerUsageContinuous = 0.4
		//PowerCapacity = (&~/Part/Components/MainBatteryStorage/MaxResources) / 1000

		RecPower = (&PowerUsageContinuous) + 0.5
		RecCrew = (&RecPower) * 4
	}
}