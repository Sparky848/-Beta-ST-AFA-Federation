		{
			Type = PartCrew
			Crew = 3
			DefaultPriority = &/PRIORITIES/ControlRoom_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			CrewDestinations
			[
				[3, 1.2]
				[3, 4.8]
				[1.2, 3]
				[4.8, 3]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
				CrewLocation3
				CrewLocation4
			]
			SwitchLocationInterval = [5, 10]
		}
		
