			OperationalToggle = RightShuntReset
			InvertOperationalToggle = true
			ShowProgressFor = RightShuntReset
			LowColor = [25, 113, 255]
			HighColor = &LowColor
			FullColor = &LowColor
			Height = 6
		}
		RightShuntToggleTrigger
		{
			Type = ToggleTrigger
			Toggle = RightShuntToggle
			TriggerWhenOff = true
			TriggerWhenOn = true
		}
		//Back Shunt
		BackShuntReset
		{
			Type = Timer
			Duration = 3
			StartExpired = true
			StartTrigger = BackShuntToggleTrigger
			//StopTrigger = BackShuntToggleTrigger
			//ResetTrigger = BackShuntToggleTrigger
			DurationAfterResetTrigger = 0
		}
		BackShuntResetProgress
		{
			Type = ProgressBar
			OperationalToggle = BackShuntReset
			InvertOperationalToggle = true
			ShowProgressFor = BackShuntReset
