	PenetrationResistance_XXL = [325, 0]
	PenetrationResistance_G = [375, 0]

	XLFromToQuantity = 5000
	XLInterval = .5

	XXLFromToQuantity = 4720
	XXLInterval = .5// 9.44/sec

	GFromToQuantity = 4387//4387.09677419355
	GInterval = .5// 8.774
	
	BlockedTravelCells
	[
		[2, 2]
		[2, 3]
		[3, 2]
		[3, 3]
	]
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[-1, 1]
		[1, -1]
		[4, -1]
		[6, 1]
		[6, 4]
		[4, 6]
		[1, 6]
