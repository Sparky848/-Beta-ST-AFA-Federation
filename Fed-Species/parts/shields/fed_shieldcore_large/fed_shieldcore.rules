	AIValueFactor = 15
	Size = [6, 6]
	SelectionPriority = 1
	SelectionTypeID = "shield_gen"
	SelectionTypeByRotation = true
	MaxHealth = 9000
	TypeCategories = [defense, uses_power, shieldcore, adapted]
	ReceivableBuffs : ^/0/ReceivableBuffs [DeflectorShieldBuff, ShuntStateBuff, ShieldcoreCounter, XSShieldcoreDebuff, SShieldcoreDebuff, MShieldcoreDebuff, LShieldcoreDebuff, XLShieldcoreDebuff, XXLShieldcoreDebuff, GShieldcoreDebuff]
