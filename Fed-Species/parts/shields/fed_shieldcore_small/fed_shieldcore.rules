		//
		// Crew
		//
		
		CrewLocation1
		{
			Type = CrewLocation
			Location = [1, 0.4]
			Rotation = 180d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [1, 1.6]
			Rotation = 0d
		}
		CrewLocation3
		{
			Type = CrewLocation
			Location = [0.4, 1]
			Rotation = 90d
		}
		CrewLocation4
		{
			Type = CrewLocation
			Location = [1.6, 1]
			Rotation = 270d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/ControlRoom_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			CrewDestinations
			[
				[1, 0.3]
				[1, 1.7]
				[0.3, 1]
				[1.7, 1]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
				CrewLocation3
				CrewLocation4
			]
			SwitchLocationInterval = [5, 10]
		}
		
