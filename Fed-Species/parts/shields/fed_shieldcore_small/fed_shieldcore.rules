Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/ShieldCoreSmall"
	IconNameKey = "Parts/ShieldCoreIconSmall"
	ID = "stafa.fed_shieldcore_small"
	EditorGroup = "StarfleetDefences"
	DescriptionKey = "Parts/ShieldCoreDescSmall"
	Resources
	[
		[duranium_alloy, 104]
		[steel, 32]
		[coil2, 48]
		[coil, 26]
		[diamond, 6]
		[processor, 3]//63,860
		/*[steel, 250]
		[coil, 62]
		[coil2, 36]
		[tristeel, 50]
		[processor, 3]
		[diamond, 6]*/ //64,000 Credits
	]
	AIValueFactor = 5
	Size = [2, 2]
	SelectionPriority = 1
	SelectionTypeID = "shield_gen"
	SelectionTypeByRotation = true
	MaxHealth = 3000
	TypeCategories = [defense, uses_power, shieldcore, adapted]
	ReceivableBuffs : ^/0/ReceivableBuffs [DeflectorShieldBuff, ShuntStateBuff]
	PenetrationRectType = Normal
	Radius_XS = 15
	Radius_S = 25

	PenetrationResistance_S = [125, 0]
	XSFromToQuantity = 2800
	XSInterval = .5

	SFromToQuantity = 4182//4181.81818181818
	SInterval = .5

	ForceManhattanPathInPart = true

	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [48, 48]
	}
	SHUNT_OPERATIONAL = ShuntReset
	SHUNT_FRONT_OPERATIONAL = FrontShuntReset
	SHUNT_BACK_OPERATIONAL = BackShuntReset
	SHUNT_LEFT_OPERATIONAL = LeftShuntReset
	SHUNT_RIGHT_OPERATIONAL = RightShuntReset
	//SHUNTTOGGLE_OPERATIONAL = ShuntToggleReset
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, &~/Part/SHUNT_OPERATIONAL, &~/Part/SHUNT_FRONT_OPERATIONAL, &~/Part/SHUNT_BACK_OPERATIONAL, &~/Part/SHUNT_LEFT_OPERATIONAL, &~/Part/SHUNT_RIGHT_OPERATIONAL]//&~/Part/SHUNTTOGGLE_OPERATIONAL 
			Mode = All
		}
		//Operational Proxies
		FrontIsOperationalProxy
		{
			Type = ToggleProxy
			ComponentID = FrontIsOperational
		}
		LeftIsOperationalProxy
		{
			Type = ToggleProxy
			ComponentID = LeftIsOperational
		}
		RightIsOperationalProxy
		{
			Type = ToggleProxy
			ComponentID = RightIsOperational
		}
		BackIsOperationalProxy
		{
			Type = ToggleProxy
			ComponentID = BackIsOperational
		}//crashes might be due to these, might need one for each face
		
		//Battery Proxies
		FrontBatteryStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = FrontBatteryStorage
			ResourceType = battery
			IsDrainable = true
		}
		LeftBatteryStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = LeftBatteryStorage
			ResourceType = battery
			IsDrainable = true
		}
		RightBatteryStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = RightBatteryStorage
			ResourceType = battery
			IsDrainable = true
		}
		BackBatteryStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = BackBatteryStorage
			ResourceType = battery
			IsDrainable = true
		}
		//--
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 10
		}
		
		//
		// BaseArcShield
		//
		BaseArcShield
		{
			Type = ArcShield
			Radius = 0.01
			Arc = 0.01d
			OperationalToggle = IsOperational
			PenetrationResistance = [75, 0]
			//DrainResourcesFrom = FrontBatteryStorage
			//ResourceDrainPerDamage = .4
			Rotation = -90d
			Location = [1, 1]
			

			BlueprintArcSprite
			{
				Texture
				{
					File = "shield_energy.png"
					SampleMode = Linear
					MipLevels = 1
				}
				Size = [0, .75]
				Color = [0, 0, 255, 127]
			}
			BlueprintArcSpriteSegments = 64

			CoverageArcSprite
			{
				Texture
				{
					File = "shield_energy.png"
					SampleMode = Linear
					MipLevels = 1
				}
				Size = [0, .75]
				Color = [255, 255, 255, 127]
			}
			CoverageArcSpriteSegments = 64

			ShieldMediaEffects
			[
				{
					Type = ArcShield
					Radius = &~/Part/Components/BaseArcShield/Radius
					Arc = &~/Part/Components/BaseArcShield/Arc
					FadeInTime = .25
					FadeOutTime = .25
					FadeFromScale = .8
					
					ArcSprite
					{
						Texture
						{
							File = "shield_energy.png"
							SampleMode = Linear
							MipLevels = 1
						}
						Shader = "shield.shader"
						_waveTex
						{
							File = "shield_energy_wave.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_maskTex
						{
							File = "shield_mask.png"
							SampleMode = Linear
							MipLevels = 1
						}
						_waveSpeed = 1
						_waveAlpha = 1
						_waveCurveInterval = .5
						_waveCurveMagnitude = .35
						_waveCurveUOffsetPerSecond = .2
						_fullPowerColor1 = [54, 0, 91, 127]
						_lowPowerColor1 = [54, 0, 91, 127]
						_fullPowerColor2 = [0, 0, 255, 127]
						_lowPowerColor2 = [255, 0, 0, 127]
						_lowPowerThicknessExponent = .6
						_xScale = 1
						TargetBlendMode = Add
						Size = [0, .75]
					}
					ArcSpriteSegments = 64
					Bucket = Lower1
				}

				: /BASE_SOUNDS/AudioExteriorDetail
				{
					Sound = "shield_loop.wav"
					Volume = .075
					Speed = .5
					MaxConcurrent = 1
					MaxConcurrentVolume = .075
					DynamicVolume : ^/0/DynamicVolume
					{
						MinDistance = .75
						MaxDistance = 1.5
					}
					IgnoreIntensity = true
				}
			]

			HitMediaEffects
			[
				{
					Type = ArcShield
					FadeInTime = .1
					FadeOutTime = .5
					Radius = &~/Part/Components/BaseArcShield/Radius
					Arc = 20d
					ArcSprite
					{
						Texture
						{
							File = "shield_energy_original.png"
							SampleMode = Linear
							MipLevels = max
						}
						Shader = "shield.shader"
						_waveTex
						{
							File = "shield_energy_wave.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_maskTex
						{
							File = "shield_energy_original.png"
							SampleMode = Linear
							MipLevels = max
						}
						_waveSpeed = -2
						_waveAlpha = .75
						_waveCurveInterval = 1
						_waveCurveMagnitude = .25
						_waveCurveUOffsetPerSecond = 0
						//TargetBlendMode = Add
						_fullPowerColor1 = [0, 0, 255, 127]
						_lowPowerColor1 = [255, 0, 0, 200]
						_fullPowerColor2 = [154, 98, 238, 127]
						_lowPowerColor2 = [236, 150, 234, 127]
						_lowPowerThicknessExponent = .6
						_xScale = 1
						TargetBlendMode = Add
						Size = [0, 1.5]
					}
					ArcSpriteSegments = 6
					Bucket = Upper3
				}

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "shield_hit.wav"
					Volume = 1
					Speed = 1
					IgnoreIntensity = true
					SpeedVariation = .25
					MaxConcurrent = 10
				}
			]
		}
		
		BaseEmitterEffect
		{
			Type = ContinuousEffects
			ChainedTo = BaseArcShield
			//FactorMediaEffectsIntensityWith = FrontBatteryStorage
			Location = [1.1, 0]
			OperationalToggle = IsOperational
